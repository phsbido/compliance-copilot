# Modelo Ollama usado pela Camada 2 (Núcleo de Raciocínio do LLM)
OLLAMA_MODEL=llama3.1

# Endereço do servidor Ollama local (padrão do próprio Ollama). No Windows,
# http://127.0.0.1:11434 evita ~2 s por conexão nova (o "localhost" tenta
# IPv6 primeiro); o padrão foi mantido porque é o das rodadas v1-v7.
OLLAMA_HOST=http://localhost:11434

# Parâmetros de amostragem (v4) — ver src/config.py e
# docs/decisoes_arquitetura.md, Camada 2. Classificação (parecer / fora de
# escopo / normativo) em 0; síntese da resposta em 0,1; seed fixa para
# reprodutibilidade. Deixe OLLAMA_SEED vazio para seed aleatória.
OLLAMA_TEMPERATURA_CLASSIFICACAO=0
OLLAMA_TEMPERATURA_SINTESE=0.1
OLLAMA_SEED=42

# Limiar de pontuação BM25 do melhor trecho (Camada 5, v6) — abaixo dele a
# busca não devolve trechos e a resposta vira recusa sem base. Vazio =
# desligado (comportamento da v5). Ver docs/decisoes_arquitetura.md.
LIMIAR_BM25=

# Recuperação da Camada 5 (v7) — bm25 (padrão), embeddings ou hybrid (BM25 +
# embeddings por Reciprocal Rank Fusion). Os modos com embeddings usam o
# modelo abaixo no mesmo Ollama (`ollama pull bge-m3`), na CPU por padrão:
# na GPU de 8 GB ele não cabe junto com o llama3.1 (OLLAMA_EMBEDDINGS_GPU=1
# para tentar a GPU). LIMIAR_COSSENO: cosseno mínimo do melhor trecho nos
# modos com embeddings; vazio = desligado. Ver docs/decisoes_arquitetura.md,
# "Camada 5: embeddings e busca híbrida".
RECUPERACAO_MODO=bm25
OLLAMA_MODELO_EMBEDDINGS=bge-m3
OLLAMA_EMBEDDINGS_GPU=
LIMIAR_COSSENO=
